{% extends '/templates/base_admin.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleAdmin.css">
    <script>
        // Функція для показу повідомлень (замість alert)
        function showNotification(message, type = 'info') {
            // Видаляємо попереднє повідомлення, якщо є
            const existing = document.getElementById('notification-message');
            if (existing) {
                existing.remove();
            }
            
            const notification = document.createElement('div');
            notification.id = 'notification-message';
            notification.className = 'notification notification-' + type;
            notification.innerHTML = `
                <div class="notification-content">
                    <span class="notification-icon">${type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ'}</span>
                    <span class="notification-text">${message}</span>
                    <button class="notification-close" onclick="this.closest('.notification').remove()">×</button>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            // Показуємо з анімацією
            setTimeout(() => {
                notification.classList.add('show');
            }, 10);
            
            // Автоматично приховуємо через 5 секунд
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => notification.remove(), 300);
            }, 5000);
        }
        
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.admin-product-form form');
            if (!form) return;

            const addButton = document.querySelector('.admin-add-button');
            const cards = document.querySelectorAll('.admin-product-card');

            const fieldId = document.getElementById('product-id');
            const fieldName = document.getElementById('product-name');
            const fieldQuantity = document.getElementById('product-quantity');
            const fieldUnit = document.getElementById('product-unit');
            const fieldTemperature = document.getElementById('product-temperature');
            const fieldLightening = document.getElementById('product-lightening');
            const fieldDescription = document.getElementById('product-description');
            const fieldAllergen = document.getElementById('product-allergen');
            const submitBtn = document.getElementById('product-submit-btn');
            const clearBtn = document.getElementById('product-clear-btn');

            function fillFormFromCard(card) {
                fieldId.value = card.dataset.id || '';
                fieldName.value = card.dataset.name || '';
                fieldQuantity.value = card.dataset.quantity || '';
                fieldUnit.value = card.dataset.unit || 'g';
                fieldTemperature.value = card.dataset.temperature || '';
                fieldLightening.value = card.dataset.lightening || '';
                fieldDescription.value = card.dataset.description || '';
                fieldAllergen.checked = card.dataset.allergen === '1';
                updateSubmitButton();
            }

            function updateSubmitButton() {
                if (fieldId.value && fieldId.value !== '') {
                    submitBtn.textContent = 'Save Edit';
                } else {
                    submitBtn.textContent = 'Create';
                }
            }

            cards.forEach(function (card) {
                const editBtn = card.querySelector('.admin-btn-edit');
                const deleteBtn = card.querySelector('.admin-btn-delete');

                if (editBtn) {
                    editBtn.addEventListener('click', function () {
                        fillFormFromCard(card);
                        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    });
                }

                // Delete is now handled by link with confirmation
            });

            addButton?.addEventListener('click', function () {
                form.reset();
                fieldId.value = '';
                fieldUnit.value = 'g';
                fieldAllergen.checked = false;
                updateSubmitButton();
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            clearBtn?.addEventListener('click', function () {
                form.reset();
                fieldId.value = '';
                fieldUnit.value = 'g';
                fieldAllergen.checked = false;
                updateSubmitButton();
            });

            // Update button text on page load
            updateSubmitButton();
            
            // Обробка кнопок видалення з підтвердженням
            document.querySelectorAll('.admin-btn-delete').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    const productName = this.dataset.productName;
                    
                    // Показуємо модальне вікно підтвердження
                    showDeleteConfirmation(productName, productId);
                });
            });
        });
        
        // Функція для показу підтвердження видалення
        function showDeleteConfirmation(productName, productId) {
            // Видаляємо попереднє підтвердження, якщо є
            const existing = document.getElementById('delete-confirmation');
            if (existing) {
                existing.remove();
            }
            
            const overlay = document.createElement('div');
            overlay.id = 'delete-confirmation';
            overlay.className = 'delete-confirmation-overlay';
            
            const content = document.createElement('div');
            content.className = 'delete-confirmation-content';
            content.innerHTML = `
                <div class="delete-confirmation-header">
                    <span class="delete-confirmation-icon">⚠️</span>
                    <h3>Confirm Deletion</h3>
                </div>
                <div class="delete-confirmation-body">
                    <p>Are you sure you want to delete <strong>${productName}</strong>?</p>
                    <p class="delete-confirmation-warning">This action cannot be undone.</p>
                </div>
                <div class="delete-confirmation-footer">
                    <button class="delete-confirm-btn delete-confirm-yes">Yes, Delete</button>
                    <button class="delete-confirm-btn delete-confirm-no">Cancel</button>
                </div>
            `;
            
            overlay.appendChild(content);
            document.body.appendChild(overlay);
            
            // Обробка кнопок
            const yesBtn = content.querySelector('.delete-confirm-yes');
            const noBtn = content.querySelector('.delete-confirm-no');
            
            yesBtn.addEventListener('click', function() {
                overlay.remove();
                window.location.href = 'index.php?action=adminProductDelete&id=' + productId;
            });
            
            noBtn.addEventListener('click', function() {
                overlay.remove();
            });
            
            // Показуємо з анімацією
            setTimeout(() => {
                overlay.classList.add('show');
            }, 10);
        }
    </script>
{% endblock %}

{% block content %}
<section class="admin-page admin-page-dashboard">
    <div class="admin-dashboard">
        <div class="admin-layout">
            {% include 'partials/adminSidebar.twig' %}

            <main class="admin-main">
                <header class="admin-main-header">
                    <div>
                        <h1>Products (Ingredients)</h1>
                        <p>Manage individual products/ingredients that can be used in recipes.</p>
                    </div>
                    <button class="admin-add-button">+ New Product</button>
                </header>

                {% if success is defined and success is not empty %}
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            {% if success == 'created' %}
                                showNotification('Product created successfully!', 'success');
                            {% elseif success == 'updated' %}
                                showNotification('Product updated successfully!', 'success');
                            {% elseif success == 'deleted' %}
                                showNotification('Product deleted successfully!', 'success');
                            {% endif %}
                        });
                    </script>
                {% endif %}

                <section class="admin-products">
                    <div class="admin-products-list">
                        {% if products %}
                            {% for product in products %}
                                <article class="admin-product-card"
                                         data-id="{{ product.id }}"
                                         data-name="{{ product.name }}"
                                         data-quantity="{{ product.quantity }}"
                                         data-unit="{{ product.unit }}"
                                         data-temperature="{{ product.temperature ?? '' }}"
                                         data-lightening="{{ product.lightening ?? '' }}"
                                         data-description="{{ product.description ?? '' }}"
                                         data-allergen="{{ product.allergen ? '1' : '0' }}">
                                    <div class="admin-product-info">
                                        <h3>{{ product.name }}</h3>
                                        <p class="admin-product-meta">
                                            Quantity: {{ product.quantity }} {{ product.unit }}
                                            {% if product.temperature %} · Temp: {{ product.temperature }}°C{% endif %}
                                            {% if product.lightening %} · Light: {{ product.lightening }}%{% endif %}
                                        </p>
                                        {% if product.description %}
                                            <p class="admin-product-description">{{ product.description }}</p>
                                        {% endif %}
                                        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                                            {% if product.allergen %}
                                                <span class="admin-allergen-badge admin-allergen-badge-yes">Contains Allergens</span>
                                            {% else %}
                                                <span class="admin-allergen-badge admin-allergen-badge-no">No Allergens</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="admin-product-actions">
                                        <button class="admin-btn admin-btn-edit">Edit</button>
                                        <button class="admin-btn admin-btn-delete" 
                                                data-product-id="{{ product.id }}"
                                                data-product-name="{{ product.name }}">Delete</button>
                                    </div>
                                </article>
                            {% endfor %}
                        {% else %}
                            <p style="text-align: center; color: #6b6f78; padding: 40px;">No products found. Create your first product!</p>
                        {% endif %}
                    </div>

                    <aside class="admin-product-form">
                        <h2>Product Form</h2>
                        <p class="admin-form-hint">Create or edit a product. Fields marked with * are required.</p>

                        {% if error %}
                            <div style="background-color: #fff2f2; border: 1px solid #dc3545; border-radius: 8px; padding: 12px; margin-bottom: 16px; color: #dc3545; font-size: 13px;">
                                {{ error }}
                            </div>
                        {% endif %}

                        <form method="POST" action="index.php?action=adminProducts">
                            <input type="hidden" name="id" id="product-id">

                            <label class="admin-label">
                                <span>Name *</span>
                                <input type="text" name="name" id="product-name" placeholder="Minimal Face Cream" required maxlength="120">
                                <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Max 120 characters</small>
                            </label>

                            <div class="admin-label-row">
                                <label class="admin-label admin-label-inline">
                                    <span>Quantity *</span>
                                    <input type="number" name="quantity" id="product-quantity" min="0" step="0.01" placeholder="100" required>
                                    <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 10px;">Must be ≥ 0</small>
                                </label>

                                <label class="admin-label admin-label-inline">
                                    <span>Unit *</span>
                                    <select name="unit" id="product-unit" required>
                                        <option value="g">g</option>
                                        <option value="kg">kg</option>
                                        <option value="ml" selected>ml</option>
                                        <option value="l">l</option>
                                        <option value="pcs">pcs</option>
                                    </select>
                                </label>
                            </div>

                            <div class="admin-label-row">
                                <label class="admin-label admin-label-inline">
                                    <span>Temperature (°C)</span>
                                    <input type="number" name="temperature" id="product-temperature" step="0.1" placeholder="20">
                                    <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 10px;">Optional</small>
                                </label>

                                <label class="admin-label admin-label-inline">
                                    <span>Lightening (%)</span>
                                    <input type="number" name="lightening" id="product-lightening" min="0" max="100" step="1" placeholder="50">
                                    <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 10px;">Optional (0-100)</small>
                                </label>
                            </div>

                            <label class="admin-label">
                                <span>Description</span>
                                <textarea name="description" id="product-description" rows="3" placeholder="Gentle cream for daily use..."></textarea>
                                <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Optional text description</small>
                            </label>

                            <div class="admin-allergen-toggle-wrapper">
                                <label class="admin-allergen-toggle">
                                    <input type="checkbox" name="allergen" id="product-allergen">
                                    <span class="admin-allergen-toggle-slider"></span>
                                    <span class="admin-allergen-toggle-label">Contains allergens</span>
                                </label>
                            </div>

                            <div class="admin-form-actions">
                                <button type="submit" class="admin-btn admin-btn-save" id="product-submit-btn">Create</button>
                                <button type="button" class="admin-btn admin-btn-secondary" id="product-clear-btn">Clear</button>
                            </div>
                        </form>
                    </aside>
                </section>
            </main>
        </div>
    </div>
</section>
{% endblock %}


