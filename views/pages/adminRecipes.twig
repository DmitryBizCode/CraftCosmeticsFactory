{% extends '/templates/base_admin.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleAdmin.css">
    <script>
        // Функція для показу повідомлень (замість alert) - однакова з Products/IoT
        function showNotification(message, type = 'info') {
            // Видаляємо попереднє повідомлення, якщо є
            const existing = document.getElementById('notification-message');
            if (existing) {
                existing.remove();
            }
            
            const notification = document.createElement('div');
            notification.id = 'notification-message';
            notification.className = 'notification notification-' + type;
            notification.innerHTML = `
                <div class="notification-content">
                    <span class="notification-icon">${type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ'}</span>
                    <span class="notification-text">${message}</span>
                    <button class="notification-close" onclick="this.closest('.notification').remove()">×</button>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            // Показуємо з анімацією
            setTimeout(() => {
                notification.classList.add('show');
            }, 10);
            
            // Автоматично приховуємо через 5 секунд
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => notification.remove(), 300);
            }, 5000);
        }
        window.showNotification = showNotification; // Експортуємо в глобальну область
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.admin-recipe-form form');
            if (!form) return;

            const addButton = document.querySelector('.admin-add-button');
            const cards = document.querySelectorAll('.admin-recipe-card');
            const productsContainer = document.getElementById('selected-products');

            const fieldId = document.getElementById('recipe-id');
            const fieldName = document.getElementById('recipe-name');
            const fieldTimeHours = document.getElementById('time-hours');
            const fieldTimeMinutes = document.getElementById('time-minutes');
            const fieldTimeSeconds = document.getElementById('time-seconds');
            const fieldDescription = document.getElementById('recipe-description');
            const fieldPhoto = document.getElementById('recipe-photo');
            const photoPreview = document.getElementById('photo-preview');
            const photoDeleteBtn = document.getElementById('photo-delete-btn');
            const submitBtn = document.getElementById('recipe-submit-btn');
            const clearBtn = document.getElementById('recipe-clear-btn');

            let selectedProducts = [];
            let selectedIotSensors = [];

            // Функції для показу/приховування повідомлень про помилки
            function showProductError(message) {
                const errorDiv = document.getElementById('product-error-message');
                if (errorDiv) {
                    errorDiv.textContent = message;
                    errorDiv.style.display = 'block';
                    setTimeout(() => {
                        errorDiv.style.display = 'none';
                    }, 4000);
                }
            }

            function showIotError(message) {
                const errorDiv = document.getElementById('iot-error-message');
                if (errorDiv) {
                    errorDiv.textContent = message;
                    errorDiv.style.display = 'block';
                    setTimeout(() => {
                        errorDiv.style.display = 'none';
                    }, 4000);
                }
            }

            function updateSubmitButton() {
                if (fieldId.value && fieldId.value !== '') {
                    submitBtn.textContent = 'Save Edit';
                } else {
                    submitBtn.textContent = 'Create';
                }
            }

            function renderSelectedProducts() {
                productsContainer.innerHTML = '';
                if (selectedProducts.length === 0) {
                    // Не показуємо нічого, контейнер буде прихований через CSS :empty
                    return;
                }
                selectedProducts.forEach(function(product, index) {
                    const div = document.createElement('div');
                    div.className = 'admin-selected-product';
                    div.innerHTML = `
                        <span>${product.name} - ${product.quantity} ${product.unit}</span>
                        <button type="button" class="admin-btn-remove-product" data-index="${index}">×</button>
                    `;
                    productsContainer.appendChild(div);
                });
                updateProductsInput();
            }

            function renderSelectedIotSensors() {
                const iotContainer = document.getElementById('selected-iot-sensors');
                if (!iotContainer) return;
                iotContainer.innerHTML = '';
                if (selectedIotSensors.length === 0) {
                    // Не показуємо нічого, контейнер буде прихований через CSS :empty
                    updateIotSensorsInput(); // Оновлюємо hidden input навіть якщо немає сенсорів
                    return;
                }
                selectedIotSensors.forEach(function(sensor, index) {
                    const div = document.createElement('div');
                    div.className = 'admin-selected-product';
                    div.innerHTML = `
                        <span>${sensor.name}</span>
                        <button type="button" class="admin-btn-remove-product" data-index="${index}" data-type="iot">×</button>
                    `;
                    iotContainer.appendChild(div);
                });
                updateIotSensorsInput();
            }

            function updateIotSensorsInput() {
                const hiddenInput = document.getElementById('iot-sensors-json');
                hiddenInput.value = JSON.stringify(selectedIotSensors.map(s => s.id));
            }

            function updateProductsInput() {
                const hiddenInput = document.getElementById('products-json');
                hiddenInput.value = JSON.stringify(selectedProducts);
            }

            // Забороняємо введення дробових чисел в поле кількості
            const quantityInput = document.getElementById('product-quantity-input');
            if (quantityInput) {
                quantityInput.addEventListener('input', function(e) {
                    // Видаляємо крапку та кому
                    let value = e.target.value;
                    value = value.replace(/[.,]/g, '');
                    if (e.target.value !== value) {
                        e.target.value = value;
                    }
                });
                
                // Забороняємо введення крапки та коми
                quantityInput.addEventListener('keydown', function(e) {
                    if (e.key === '.' || e.key === ',' || e.key === 'e' || e.key === 'E' || e.key === '+' || e.key === '-') {
                        e.preventDefault();
                    }
                });
            }

            function addProduct() {
                const productSelect = document.getElementById('product-select');
                const productId = productSelect.value;
                const quantityValue = quantityInput.value.trim();

                if (!productId) {
                    showProductError('Please select a product');
                    productSelect.focus();
                    productSelect.style.borderColor = '#dc3545';
                    setTimeout(() => {
                        productSelect.style.borderColor = '';
                    }, 2000);
                    return;
                }

                if (!quantityValue || quantityValue === '' || quantityValue === '0') {
                    showProductError('Please enter a valid quantity (must be greater than 0)');
                    quantityInput.focus();
                    quantityInput.style.borderColor = '#dc3545';
                    setTimeout(() => {
                        quantityInput.style.borderColor = '';
                    }, 2000);
                    return;
                }

                const quantity = parseInt(quantityValue, 10);
                if (quantity <= 0 || isNaN(quantity) || !Number.isInteger(parseFloat(quantityValue))) {
                    showProductError('Please enter a whole number (integer) greater than 0');
                    quantityInput.focus();
                    quantityInput.style.borderColor = '#dc3545';
                    setTimeout(() => {
                        quantityInput.style.borderColor = '';
                    }, 2000);
                    return;
                }
                
                // Перевіряємо, чи не містить дробову частину
                if (quantityValue.includes('.') || quantityValue.includes(',')) {
                    showProductError('Please enter a whole number only (no decimals)');
                    quantityInput.focus();
                    quantityInput.style.borderColor = '#dc3545';
                    setTimeout(() => {
                        quantityInput.style.borderColor = '';
                    }, 2000);
                    return;
                }

                const productOption = productSelect.options[productSelect.selectedIndex];
                const productName = productOption.text.split(' (')[0];
                const productUnit = productOption.text.match(/\(([^)]+)\)/)?.[1] || '';

                // Перевіряємо, чи продукт вже додано
                const existingProductIndex = selectedProducts.findIndex(p => p.id === productId);
                
                if (existingProductIndex !== -1) {
                    // Якщо продукт вже є, оновлюємо його кількість
                    selectedProducts[existingProductIndex].quantity = quantity;
                    showProductError('Product already added. Quantity updated.');
                } else {
                    // Якщо продукту немає, додаємо новий
                    selectedProducts.push({
                        id: productId,
                        name: productName,
                        quantity: quantity,
                        unit: productUnit
                    });
                }

                renderSelectedProducts();
                productSelect.value = '';
                quantityInput.value = '';
                
                // Приховуємо повідомлення про помилку через 2 секунди (якщо це було оновлення)
                setTimeout(() => {
                    const errorDiv = document.getElementById('product-error-message');
                    if (errorDiv) {
                        errorDiv.style.display = 'none';
                    }
                }, 2000);
            }

            document.getElementById('add-product-btn')?.addEventListener('click', addProduct);

            productsContainer.addEventListener('click', function(e) {
                if (e.target.classList.contains('admin-btn-remove-product') && !e.target.dataset.type) {
                    const index = parseInt(e.target.dataset.index);
                    selectedProducts.splice(index, 1);
                    renderSelectedProducts();
                }
            });

            function addIotSensor() {
                const iotSelect = document.getElementById('iot-sensor-select');
                const iotId = iotSelect.value;

                if (!iotId) {
                    showIotError('Please select an IoT sensor');
                    iotSelect.focus();
                    iotSelect.style.borderColor = '#dc3545';
                    setTimeout(() => {
                        iotSelect.style.borderColor = '';
                    }, 2000);
                    return;
                }

                // Перевіряємо чи вже додано
                if (selectedIotSensors.find(s => s.id === parseInt(iotId))) {
                    showIotError('This sensor is already added');
                    iotSelect.focus();
                    iotSelect.style.borderColor = '#dc3545';
                    setTimeout(() => {
                        iotSelect.style.borderColor = '';
                    }, 2000);
                    return;
                }

                const sensorOption = iotSelect.options[iotSelect.selectedIndex];
                const sensorName = sensorOption.text;

                selectedIotSensors.push({
                    id: parseInt(iotId),
                    name: sensorName
                });

                renderSelectedIotSensors(); // Вже викликає updateIotSensorsInput()
                iotSelect.value = '';
                // Приховуємо повідомлення про помилку при успішному додаванні
                const errorDiv = document.getElementById('iot-error-message');
                if (errorDiv) {
                    errorDiv.style.display = 'none';
                }
            }

            document.getElementById('add-iot-btn')?.addEventListener('click', addIotSensor);

            document.getElementById('selected-iot-sensors')?.addEventListener('click', function(e) {
                if (e.target.classList.contains('admin-btn-remove-product') && e.target.dataset.type === 'iot') {
                    const index = parseInt(e.target.dataset.index);
                    selectedIotSensors.splice(index, 1);
                    renderSelectedIotSensors(); // Вже викликає updateIotSensorsInput()
                }
            });

            function fillFormFromCard(card) {
                fieldId.value = card.dataset.id || '';
                fieldName.value = card.dataset.name || '';
                
                // Парсимо час з годин в окремі компоненти
                const totalHours = parseFloat(card.dataset.timeToComplete || 0);
                const totalSeconds = Math.round(totalHours * 3600);
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;
                
                document.getElementById('time-hours').value = hours;
                document.getElementById('time-minutes').value = minutes;
                document.getElementById('time-seconds').value = seconds;
                
                fieldDescription.value = card.dataset.description || '';
                
                // Завантажуємо продукти та IoT сенсори
                const productsData = card.dataset.products || '[]';
                selectedProducts = JSON.parse(productsData);
                renderSelectedProducts();
                
                const iotData = card.dataset.iotSensors || '[]';
                const iotIds = JSON.parse(iotData);
                selectedIotSensors = [];
                if (iotIds.length > 0) {
                    const iotSelect = document.getElementById('iot-sensor-select');
                    if (iotSelect) {
                        Array.from(iotSelect.options).forEach(opt => {
                            if (opt.value && iotIds.includes(parseInt(opt.value))) {
                                selectedIotSensors.push({
                                    id: parseInt(opt.value),
                                    name: opt.text
                                });
                            }
                        });
                    }
                }
                renderSelectedIotSensors(); // Вже викликає updateIotSensorsInput()
                
                // Фото
                const photo = card.dataset.photo || '';
                if (photo && photo !== '' && photo !== 'default.png') {
                    photoPreview.src = '/image/recipes/' + photo;
                    photoPreview.style.display = 'block';
                    photoDeleteBtn.style.display = 'block';
                } else {
                    photoPreview.src = '/image/recipes/default.png';
                    photoPreview.style.display = 'block';
                    photoDeleteBtn.style.display = 'none';
                }
                
                updateSubmitButton();
            }

            cards.forEach(function (card) {
                const editBtn = card.querySelector('.admin-btn-edit');
                const deleteBtn = card.querySelector('.admin-btn-delete');
                const ecoBtn = card.querySelector('.admin-btn-eco');

                if (editBtn) {
                    editBtn.addEventListener('click', function () {
                        fillFormFromCard(card);
                        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    });
                }

                if (deleteBtn) {
                    deleteBtn.addEventListener('click', function () {
                        const recipeId = card.dataset.id;
                        const name = card.dataset.name || 'this recipe';
                        showDeleteConfirmation(name, recipeId, 'recipe');
                    });
                }

                if (ecoBtn) {
                    ecoBtn.addEventListener('click', function () {
                        const recipeId = card.dataset.id || '';
                        window.location.href = 'index.php?action=adminEcoSystem&recipe_id=' + recipeId;
                    });
                }
            });

            addButton?.addEventListener('click', function () {
                form.reset();
                fieldId.value = '';
                fieldTimeHours.value = '0';
                fieldTimeMinutes.value = '0';
                fieldTimeSeconds.value = '0';
                selectedProducts = [];
                selectedIotSensors = [];
                renderSelectedProducts();
                renderSelectedIotSensors();
                photoPreview.style.display = 'none';
                photoDeleteBtn.style.display = 'none';
                updateSubmitButton();
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            clearBtn?.addEventListener('click', function () {
                form.reset();
                fieldId.value = '';
                fieldTimeHours.value = '0';
                fieldTimeMinutes.value = '0';
                fieldTimeSeconds.value = '0';
                selectedProducts = [];
                selectedIotSensors = [];
                renderSelectedProducts();
                renderSelectedIotSensors();
                photoPreview.style.display = 'none';
                photoDeleteBtn.style.display = 'none';
                updateSubmitButton();
            });

            fieldPhoto.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        photoPreview.src = e.target.result;
                        photoPreview.style.display = 'block';
                        photoDeleteBtn.style.display = 'none'; // При завантаженні нового фото приховуємо кнопку видалення
                    };
                    reader.readAsDataURL(file);
                }
            });

            photoDeleteBtn.addEventListener('click', function() {
                if (fieldId.value) {
                    showDeleteConfirmation('photo', fieldId.value, 'photo');
                } else {
                    photoPreview.style.display = 'none';
                    fieldPhoto.value = '';
                }
            });

            updateSubmitButton();
            
            // Ініціалізуємо відображення при завантаженні сторінки
            renderSelectedProducts();
            renderSelectedIotSensors();
            updateIotSensorsInput(); // Оновлюємо hidden input при завантаженні
            
            // Обробка кнопок видалення рецептів з карток
            document.querySelectorAll('.admin-recipe-card .admin-btn-delete').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const recipeId = this.dataset.recipeId;
                    const recipeName = this.dataset.recipeName;
                    showDeleteConfirmation(recipeName, recipeId, 'recipe');
                });
            });
        });

        // Функція для показу підтвердження видалення
        function showDeleteConfirmation(name, id, type) {
            // Видаляємо попереднє підтвердження, якщо є
            const existing = document.getElementById('delete-confirmation');
            if (existing) {
                existing.remove();
            }
            
            const overlay = document.createElement('div');
            overlay.id = 'delete-confirmation';
            overlay.className = 'delete-confirmation-overlay';
            
            let message = '';
            let actionUrl = '';
            
            if (type === 'recipe') {
                message = `Are you sure you want to delete <strong>${name}</strong>?`;
                actionUrl = 'index.php?action=adminRecipeDelete&id=' + id;
            } else if (type === 'photo') {
                message = `Are you sure you want to delete the photo?`;
                actionUrl = 'index.php?action=adminRecipeDeletePhoto&id=' + id;
            }
            
            const content = document.createElement('div');
            content.className = 'delete-confirmation-content';
            content.innerHTML = `
                <div class="delete-confirmation-header">
                    <span class="delete-confirmation-icon">⚠️</span>
                    <h3>Confirm Deletion</h3>
                </div>
                <div class="delete-confirmation-body">
                    <p>${message}</p>
                    <p class="delete-confirmation-warning">This action cannot be undone.</p>
                </div>
                <div class="delete-confirmation-footer">
                    <button class="delete-confirm-btn delete-confirm-yes">Yes, Delete</button>
                    <button class="delete-confirm-btn delete-confirm-no">Cancel</button>
                </div>
            `;
            
            overlay.appendChild(content);
            document.body.appendChild(overlay);
            
            // Обробка кнопок
            const yesBtn = content.querySelector('.delete-confirm-yes');
            const noBtn = content.querySelector('.delete-confirm-no');
            
            yesBtn.addEventListener('click', function() {
                overlay.remove();
                window.location.href = actionUrl;
            });
            
            noBtn.addEventListener('click', function() {
                overlay.remove();
            });
            
            // Показуємо з анімацією
            setTimeout(() => {
                overlay.classList.add('show');
            }, 10);
        }
    </script>
{% endblock %}

{% block content %}
<section class="admin-page admin-page-dashboard">
    <div class="admin-dashboard">
        <div class="admin-layout">
            {% include 'partials/adminSidebar.twig' %}

            <main class="admin-main">
                <header class="admin-main-header">
                    <div>
                        <h1>Recipes</h1>
                        <p>Manage recipes that consist of products and have their own eco-system with IoT sensors.</p>
                    </div>
                    <button class="admin-add-button">+ New Recipe</button>
                </header>

                {% if success is defined and success is not empty %}
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            {% if success == 'created' %}
                                showNotification('Recipe created successfully!', 'success');
                            {% elseif success == 'updated' %}
                                showNotification('Recipe updated successfully!', 'success');
                            {% elseif success == 'deleted' %}
                                showNotification('Recipe deleted successfully!', 'success');
                            {% elseif success == 'photo_deleted' %}
                                showNotification('Photo deleted successfully!', 'success');
                            {% endif %}
                        });
                    </script>
                {% endif %}
                
                {% if error is defined and error is not empty %}
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            showNotification('{{ error|e('js') }}', 'error');
                        });
                    </script>
                {% endif %}

                <section class="admin-products">
                    <div class="admin-products-list">
                        {% if recipes %}
                            {% for recipe in recipes %}
                                <article class="admin-recipe-card"
                                         data-id="{{ recipe.id }}"
                                         data-name="{{ recipe.name }}"
                                         data-time-to-complete="{{ recipe.time_to_complete }}"
                                         data-description="{{ recipe.description ?? '' }}"
                                         data-photo="{{ recipe.photo ?? '' }}"
                                         data-products="{{ recipe.products_json }}"
                                         data-iot-sensors="{{ recipe.iot_sensors_json }}">
                                    <img src="/image/recipes/{{ (recipe.photo and recipe.photo != '') ? recipe.photo : 'default.png' }}" alt="{{ recipe.name }}" class="admin-recipe-photo">
                                    <div class="admin-product-info">
                                        <h3>{{ recipe.name }}</h3>
                                        <p class="admin-product-meta">
                                            Products: {{ recipe.products|length }} · 
                                            IoT Sensors: {{ recipe.iot_sensors|length }} · 
                                            Time: {% if recipe.time_to_complete < 0.0167 %}{{ (recipe.time_to_complete * 3600)|round }} sec{% elseif recipe.time_to_complete < 1 %}{{ (recipe.time_to_complete * 60)|round(1) }} min{% elseif recipe.time_to_complete < 24 %}{{ recipe.time_to_complete|round(1) }} hours{% else %}{{ (recipe.time_to_complete / 24)|round(1) }} days{% endif %}
                                        </p>
                                        {% if recipe.description %}
                                            <p class="admin-product-description">{{ recipe.description }}</p>
                                        {% endif %}
                                    </div>
                                    <div class="admin-product-actions">
                                        <button class="admin-btn admin-btn-edit">Edit</button>
                                        <button class="admin-btn admin-btn-eco">Eco System</button>
                                        <button class="admin-btn admin-btn-delete" 
                                                data-recipe-id="{{ recipe.id }}"
                                                data-recipe-name="{{ recipe.name }}">Delete</button>
                                    </div>
                                </article>
                            {% endfor %}
                        {% else %}
                            <p style="text-align: center; color: #6b6f78; padding: 40px;">No recipes found. Create your first recipe!</p>
                        {% endif %}
                    </div>

                    <aside class="admin-product-form admin-recipe-form">
                        <h2>Recipe Form</h2>
                        <p class="admin-form-hint">Create or edit a recipe. Select products with quantities and IoT sensors.</p>

                        {% if error %}
                            <div style="background-color: #fff2f2; border: 1px solid #dc3545; border-radius: 8px; padding: 12px; margin-bottom: 16px; color: #dc3545; font-size: 13px;">
                                {{ error }}
                            </div>
                        {% endif %}

                        <form method="POST" action="index.php?action=adminRecipes" enctype="multipart/form-data">
                            <input type="hidden" name="id" id="recipe-id">
                            <input type="hidden" name="products" id="products-json" value="[]">
                            <input type="hidden" name="iot_sensors" id="iot-sensors-json" value="[]">

                            <label class="admin-label">
                                <span>Recipe Name *</span>
                                <input type="text" name="name" id="recipe-name" placeholder="Organic Face Cream" required maxlength="100">
                                <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Max 100 characters</small>
                            </label>

                            <div class="admin-label">
                                <span>Time to Complete *</span>
                                <div class="admin-time-inputs">
                                    <label class="admin-time-label">
                                        <span>Hours</span>
                                        <input type="number" name="time_hours" id="time-hours" min="0" step="1" placeholder="0" value="0">
                                    </label>
                                    <label class="admin-time-label">
                                        <span>Minutes</span>
                                        <input type="number" name="time_minutes" id="time-minutes" min="0" max="59" step="1" placeholder="0" value="0">
                                    </label>
                                    <label class="admin-time-label">
                                        <span>Seconds</span>
                                        <input type="number" name="time_seconds" id="time-seconds" min="0" max="59" step="1" placeholder="0" value="0">
                                    </label>
                                </div>
                                <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Enter time components separately</small>
                            </div>

                            <label class="admin-label">
                                <span>Description</span>
                                <textarea name="description" id="recipe-description" rows="3" placeholder="Recipe description..."></textarea>
                            </label>

                            <label class="admin-label">
                                <span>Photo</span>
                                <div class="admin-photo-upload-wrapper">
                                    <label for="recipe-photo" class="admin-photo-upload-btn">
                                        <i class="fas fa-upload"></i>
                                        <span>Choose Photo</span>
                                    </label>
                                    <input type="file" name="photo" id="recipe-photo" accept="image/*" style="display: none;">
                                    <small style="display: block; margin-top: 8px; color: #6b6f78; font-size: 11px;">Optional image for recipe</small>
                                </div>
                                <div style="margin-top: 12px;">
                                    <img id="photo-preview" src="" alt="Preview" style="max-width: 200px; max-height: 200px; display: none; border-radius: 8px; border: 1px solid #dde1ea;">
                                    <button type="button" id="photo-delete-btn" class="admin-btn admin-btn-delete" style="display: none; margin-top: 8px;">Delete Photo</button>
                                </div>
                            </label>

                            <div class="admin-products-selection">
                                <label class="admin-label">
                                    <span>Select Products (Ingredients) *</span>
                                    <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                                        <select id="product-select" style="flex: 1;">
                                            <option value="">Select product...</option>
                                            {% if products %}
                                                {% for product in products %}
                                                    <option value="{{ product.id }}">{{ product.name }} ({{ product.quantity }} {{ product.unit }})</option>
                                                {% endfor %}
                                            {% endif %}
                                        </select>
                                        <input type="number" id="product-quantity-input" min="1" step="1" placeholder="Qty" style="width: 100px;">
                                        <button type="button" id="add-product-btn" class="admin-btn admin-btn-save">Add</button>
                                    </div>
                                    <div id="product-error-message" class="admin-field-error-message" style="display: none;"></div>
                                    <div id="selected-products" class="admin-selected-products-list"></div>
                                    <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Add products with quantities</small>
                                </label>
                            </div>

                            <div class="admin-iot-selection">
                                <label class="admin-label">
                                    <span>Select IoT Sensors</span>
                                    <div class="admin-iot-select-wrapper">
                                        <select id="iot-sensor-select" class="admin-iot-select">
                                            <option value="">Select sensor...</option>
                                            {% if iotSensors %}
                                                {% for sensor in iotSensors %}
                                                    <option value="{{ sensor.id }}">{{ sensor.name }} ({{ sensor.start_value }} - {{ sensor.end_value }})</option>
                                                {% endfor %}
                                            {% endif %}
                                        </select>
                                        <button type="button" id="add-iot-btn" class="admin-btn admin-btn-save admin-iot-add-btn">
                                            <i class="fas fa-plus"></i> Add
                                        </button>
                                    </div>
                                    <div id="iot-error-message" class="admin-field-error-message" style="display: none;"></div>
                                    <div id="selected-iot-sensors" class="admin-selected-products-list"></div>
                                    <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Click to select and add IoT sensors for eco-system monitoring</small>
                                </label>
                            </div>

                            <div class="admin-form-actions">
                                <button type="submit" class="admin-btn admin-btn-save" id="recipe-submit-btn">Create</button>
                                <button type="button" class="admin-btn admin-btn-secondary" id="recipe-clear-btn">Clear</button>
                            </div>
                        </form>
                    </aside>
                </section>
            </main>
        </div>
    </div>
</section>
{% endblock %}
