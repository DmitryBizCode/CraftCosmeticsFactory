{% extends '/templates/base_concept.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleIndex.css">
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const categoryHeaders = document.querySelectorAll('.filter-category-header[data-toggle="subcategories"]');
            categoryHeaders.forEach(header => {
                header.addEventListener('click', function() {
                    const categoryItem = this.closest('.filter-category-item');
                    const subcategories = categoryItem.querySelector('.filter-subcategories');
                    const toggle = this.querySelector('.filter-toggle');
                    
                    if (subcategories) {
                        categoryItem.classList.toggle('active');
                        subcategories.classList.toggle('expanded');
                        toggle.textContent = subcategories.classList.contains('expanded') ? '−' : '+';
                    }
                });
            });
        });
    </script>
{% endblock %}

