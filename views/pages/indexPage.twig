{% extends '/templates/base_concept.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleIndex.css">
{% endblock %}

{% block content %}

<!-- Hero Section -->
<section class="hero-section-shop">
    <div class="hero-overlay">
        <h1 class="hero-title">Shop</h1>
    </div>
</section>

<!-- Search Section -->
<section class="search-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="search-title">Give All You Need</h2>
            </div>
            <div class="col-md-6">
                <form class="search-form">
                    <input type="text" placeholder="Q Search on Stuffsus" class="search-input">
                    <button type="submit" class="search-btn">Search</button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Main Content Section -->
<section class="main-content-section">
    <div class="container">
        <div class="row">
            <!-- Left Sidebar - Category Filters -->
            <div class="col-md-3 sidebar-filter">
                <h3 class="filter-title">Category</h3>
                <div class="filter-list">
                    <label class="filter-item">
                        <input type="checkbox" checked>
                        <span>All Product</span>
                        <span class="badge">12</span>
                    </label>
                    <label class="filter-item">
                        <input type="checkbox">
                        <span>For Home</span>
                    </label>
                    <label class="filter-item">
                        <input type="checkbox">
                        <span>For Music</span>
                    </label>
                    <label class="filter-item">
                        <input type="checkbox">
                        <span>For Phone</span>
                    </label>
                    <label class="filter-item">
                        <input type="checkbox">
                        <span>For Storage</span>
                    </label>
                </div>
                <div class="filter-options mt-4">
                    <h4 class="filter-subtitle">Options</h4>
                    <label class="filter-item">
                        <input type="radio" name="filter-option">
                        <span>New Arrival</span>
                    </label>
                    <label class="filter-item">
                        <input type="radio" name="filter-option">
                        <span>Best Seller</span>
                    </label>
                    <label class="filter-item">
                        <input type="radio" name="filter-option">
                        <span>On Discount</span>
                    </label>
                </div>
            </div>

            <!-- Right Column - Product Grid -->
            <div class="col-md-9">
                <div class="product-grid">
                    <!-- Product Card 1 -->
                    <div class="product-card">
                        <span class="product-category">Other</span>
                        <img src="/image/product-placeholder.jpg" alt="Phone Holder Sakti" class="product-image">
                        <h4 class="product-name">Phone Holder Sakti</h4>
                        <div class="product-rating">
                            <span class="stars">★★★★★</span>
                            <span class="rating-text">5.0 (12k Reviews)</span>
                        </div>
                        <div class="product-price">$29.90</div>
                        <div class="product-actions">
                            <button class="btn-add-cart">Add to Chart</button>
                            <button class="btn-buy-now">Buy Now</button>
                        </div>
                    </div>

                    <!-- Product Card 2 -->
                    <div class="product-card">
                        <span class="product-category">Music</span>
                        <img src="/image/product-placeholder.jpg" alt="Headsound" class="product-image">
                        <h4 class="product-name">Headsound</h4>
                        <div class="product-rating">
                            <span class="stars">★★★★★</span>
                            <span class="rating-text">5.0 (12k Reviews)</span>
                        </div>
                        <div class="product-price">$12.00</div>
                        <div class="product-actions">
                            <button class="btn-add-cart">Add to Chart</button>
                            <button class="btn-buy-now">Buy Now</button>
                        </div>
                    </div>

                    <!-- Product Card 3 -->
                    <div class="product-card">
                        <span class="product-category">Home</span>
                        <img src="/image/product-placeholder.jpg" alt="Adudu Cleaner" class="product-image">
                        <h4 class="product-name">Adudu Cleaner</h4>
                        <div class="product-rating">
                            <span class="stars">★★★★★</span>
                            <span class="rating-text">5.0 (12k Reviews)</span>
                        </div>
                        <div class="product-price">$50.00</div>
                        <div class="product-actions">
                            <button class="btn-add-cart">Add to Chart</button>
                            <button class="btn-buy-now">Buy Now</button>
                        </div>
                    </div>

                    <!-- Product Card 4 -->
                    <div class="product-card">
                        <span class="product-category">Other</span>
                        <img src="/image/product-placeholder.jpg" alt="CCTV Maling" class="product-image">
                        <h4 class="product-name">CCTV Maling</h4>
                        <div class="product-rating">
                            <span class="stars">★★★★★</span>
                            <span class="rating-text">5.0 (12k Reviews)</span>
                        </div>
                        <div class="product-price">$9.90</div>
                        <div class="product-actions">
                            <button class="btn-add-cart">Add to Chart</button>
                            <button class="btn-buy-now">Buy Now</button>
                        </div>
                    </div>

                    <!-- Product Card 5 -->
                    <div class="product-card">
                        <span class="product-category">Other</span>
                        <img src="/image/product-placeholder.jpg" alt="Stuffus Peker 32" class="product-image">
                        <h4 class="product-name">Stuffus Peker 32</h4>
                        <div class="product-rating">
                            <span class="stars">★★★★★</span>
                            <span class="rating-text">5.0 (12k Reviews)</span>
                        </div>
                        <div class="product-price">$34.10</div>
                        <div class="product-actions">
                            <button class="btn-add-cart">Add to Chart</button>
                            <button class="btn-buy-now">Buy Now</button>
                        </div>
                    </div>

                    <!-- Product Card 6 -->
                    <div class="product-card">
                        <span class="product-category">Other</span>
                        <img src="/image/product-placeholder.jpg" alt="Stuffus R175" class="product-image">
                        <h4 class="product-name">Stuffus R175</h4>
                        <div class="product-rating">
                            <span class="stars">★★★★★</span>
                            <span class="rating-text">5.0 (12k Reviews)</span>
                        </div>
                        <div class="product-price">$29.90</div>
                        <div class="product-actions">
                            <button class="btn-add-cart">Add to Chart</button>
                            <button class="btn-buy-now">Buy Now</button>
                        </div>
                    </div>
                </div>

                <!-- Pagination -->
                <div class="pagination-wrapper">
                    <nav class="pagination">
                        <a href="#" class="pagination-link">← Previous</a>
                        <a href="#" class="pagination-link active">1</a>
                        <a href="#" class="pagination-link">2</a>
                        <a href="#" class="pagination-link">3</a>
                        <span class="pagination-dots">...</span>
                        <a href="#" class="pagination-link">9</a>
                        <a href="#" class="pagination-link">10</a>
                        <a href="#" class="pagination-link">Next →</a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recommendations Section -->
<section class="recommendations-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Explore our recommendations</h2>
            <div class="section-nav">
                <button class="nav-arrow">←</button>
                <button class="nav-arrow">→</button>
            </div>
        </div>
        <div class="product-grid">
            <!-- Recommendation Product Cards -->
            <div class="product-card">
                <span class="product-category">Music</span>
                <img src="/image/product-placeholder.jpg" alt="TWS Bujug" class="product-image">
                <h4 class="product-name">TWS Bujug</h4>
                <div class="product-rating">
                    <span class="stars">★★★★★</span>
                    <span class="rating-text">5.0 (12k Reviews)</span>
                </div>
                <div class="product-price">$29.90</div>
                <div class="product-actions">
                    <button class="btn-add-cart">Add to Chart</button>
                    <button class="btn-buy-now">Buy Now</button>
                </div>
            </div>

            <div class="product-card">
                <span class="product-category">Music</span>
                <img src="/image/product-placeholder.jpg" alt="Headsound Baptis" class="product-image">
                <h4 class="product-name">Headsound Baptis</h4>
                <div class="product-rating">
                    <span class="stars">★★★★★</span>
                    <span class="rating-text">5.0 (12k Reviews)</span>
                </div>
                <div class="product-price">$29.90</div>
                <div class="product-actions">
                    <button class="btn-add-cart">Add to Chart</button>
                    <button class="btn-buy-now">Buy Now</button>
                </div>
            </div>

            <div class="product-card">
                <span class="product-category">Home</span>
                <img src="/image/product-placeholder.jpg" alt="Adudu Cleaner" class="product-image">
                <h4 class="product-name">Adudu Cleaner</h4>
                <div class="product-rating">
                    <span class="stars">★★★★★</span>
                    <span class="rating-text">5.0 (12k Reviews)</span>
                </div>
                <div class="product-price">$29.90</div>
                <div class="product-actions">
                    <button class="btn-add-cart">Add to Chart</button>
                    <button class="btn-buy-now">Buy Now</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Newsletter Section -->
<section class="newsletter-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="newsletter-title">Ready to Get Our New Stuff?</h2>
                <form class="newsletter-form">
                    <input type="email" placeholder="Your Email" class="newsletter-input">
                    <button type="submit" class="newsletter-btn">Send</button>
                </form>
            </div>
            <div class="col-md-6">
                <h3 class="newsletter-subtitle">Stuffsus for Homes and Needs</h3>
                <p class="newsletter-text">Discover a wide range of products for your home and daily needs. Quality products at affordable prices, delivered right to your doorstep.</p>
            </div>
        </div>
    </div>
</section>

{% endblock %}

