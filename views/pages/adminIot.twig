{% extends '/templates/base_admin.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleAdmin.css">
    <script>
        // Функція для показу повідомлень (замість alert)
        function showNotification(message, type = 'info') {
            // Видаляємо попереднє повідомлення, якщо є
            const existing = document.getElementById('notification-message');
            if (existing) {
                existing.remove();
            }
            
            const notification = document.createElement('div');
            notification.id = 'notification-message';
            notification.className = 'notification notification-' + type;
            notification.innerHTML = `
                <div class="notification-content">
                    <span class="notification-icon">${type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ'}</span>
                    <span class="notification-text">${message}</span>
                    <button class="notification-close" onclick="this.closest('.notification').remove()">×</button>
                </div>
            `;
            
            document.body.appendChild(notification);
            
            // Показуємо з анімацією
            setTimeout(() => {
                notification.classList.add('show');
            }, 10);
            
            // Автоматично приховуємо через 5 секунд
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => notification.remove(), 300);
            }, 5000);
        }
        
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.admin-iot-form form');
            if (!form) return;

            const addButton = document.querySelector('.admin-add-button');
            const cards = document.querySelectorAll('.admin-iot-card');

            const fieldId = document.getElementById('iot-id');
            const fieldName = document.getElementById('iot-name');
            const fieldStartValue = document.getElementById('iot-start-value');
            const fieldEndValue = document.getElementById('iot-end-value');
            const fieldDescription = document.getElementById('iot-description');
            const submitBtn = document.getElementById('iot-submit-btn');
            const clearBtn = document.getElementById('iot-clear-btn');

            function fillFormFromCard(card) {
                fieldId.value = card.dataset.id || '';
                fieldName.value = card.dataset.name || '';
                fieldStartValue.value = card.dataset.startValue || '';
                fieldEndValue.value = card.dataset.endValue || '';
                fieldDescription.value = card.dataset.description || '';
                updateSubmitButton();
            }

            function updateSubmitButton() {
                if (fieldId.value && fieldId.value !== '') {
                    submitBtn.textContent = 'Save Edit';
                } else {
                    submitBtn.textContent = 'Create';
                }
            }

            cards.forEach(function (card) {
                const editBtn = card.querySelector('.admin-btn-edit');
                const deleteBtn = card.querySelector('.admin-btn-delete');

                if (editBtn) {
                    editBtn.addEventListener('click', function () {
                        fillFormFromCard(card);
                        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    });
                }

                if (deleteBtn) {
                    deleteBtn.addEventListener('click', function() {
                        const sensorId = this.dataset.sensorId;
                        const sensorName = this.dataset.sensorName;
                        showDeleteConfirmation(sensorName, sensorId);
                    });
                }
            });

            addButton?.addEventListener('click', function () {
                form.reset();
                fieldId.value = '';
                updateSubmitButton();
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            clearBtn?.addEventListener('click', function () {
                form.reset();
                fieldId.value = '';
                updateSubmitButton();
            });

            updateSubmitButton();
        });

        // Функція для показу підтвердження видалення
        function showDeleteConfirmation(sensorName, sensorId) {
            // Видаляємо попереднє підтвердження, якщо є
            const existing = document.getElementById('delete-confirmation');
            if (existing) {
                existing.remove();
            }
            
            const overlay = document.createElement('div');
            overlay.id = 'delete-confirmation';
            overlay.className = 'delete-confirmation-overlay';
            
            const content = document.createElement('div');
            content.className = 'delete-confirmation-content';
            content.innerHTML = `
                <div class="delete-confirmation-header">
                    <span class="delete-confirmation-icon">⚠️</span>
                    <h3>Confirm Deletion</h3>
                </div>
                <div class="delete-confirmation-body">
                    <p>Are you sure you want to delete <strong>${sensorName}</strong>?</p>
                    <p class="delete-confirmation-warning">This action cannot be undone.</p>
                </div>
                <div class="delete-confirmation-footer">
                    <button class="delete-confirm-btn delete-confirm-yes">Yes, Delete</button>
                    <button class="delete-confirm-btn delete-confirm-no">Cancel</button>
                </div>
            `;
            
            overlay.appendChild(content);
            document.body.appendChild(overlay);
            
            // Обробка кнопок
            const yesBtn = content.querySelector('.delete-confirm-yes');
            const noBtn = content.querySelector('.delete-confirm-no');
            
            yesBtn.addEventListener('click', function() {
                overlay.remove();
                window.location.href = 'index.php?action=adminIotDelete&id=' + sensorId;
            });
            
            noBtn.addEventListener('click', function() {
                overlay.remove();
            });
            
            // Показуємо з анімацією
            setTimeout(() => {
                overlay.classList.add('show');
            }, 10);
        }
    </script>
{% endblock %}

{% block content %}
<section class="admin-page admin-page-dashboard">
    <div class="admin-dashboard">
        <div class="admin-layout">
            {% include 'partials/adminSidebar.twig' %}

            <main class="admin-main">
                <header class="admin-main-header">
                    <div>
                        <h1>IoT and Eco System Management</h1>
                        <p>Manage IoT sensors and view active eco systems.</p>
                    </div>
                    <button class="admin-add-button">+ New IoT Sensor</button>
                </header>

                {% if success is defined and success is not empty %}
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            {% if success == 'created' %}
                                showNotification('IoT sensor created successfully!', 'success');
                            {% elseif success == 'updated' %}
                                showNotification('IoT sensor updated successfully!', 'success');
                            {% elseif success == 'deleted' %}
                                showNotification('IoT sensor deleted successfully!', 'success');
                            {% endif %}
                        });
                    </script>
                {% endif %}

                <section class="admin-iot-layout">
                    <div class="admin-eco-sessions-section-full">
                        <h2 class="admin-users-title">Active Eco Sessions (eco_system)</h2>
                        <div class="admin-table-wrapper">
                            <table class="admin-table" style="text-align: center;">
                                <thead>
                                    <tr>
                                        <th style="text-align: center;">ID</th>
                                        <th style="text-align: center;">Recipe ID</th>
                                        <th style="text-align: center;">Description</th>
                                        <th style="text-align: center;">Start Date</th>
                                        <th style="text-align: center;">End Date</th>
                                        <th style="text-align: center;">Staff ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if ecoSystems %}
                                        {% for eco in ecoSystems %}
                                            <tr>
                                                <td style="text-align: center;">{{ eco.id }}</td>
                                                <td style="text-align: center;">{{ eco.recipe_id }}</td>
                                                <td style="text-align: center;">{{ eco.description ?? 'N/A' }}</td>
                                                <td style="text-align: center;">
                                                    {% if eco.date_start %}
                                                        {{ eco.date_start|date('Y-m-d H:i:s') }}
                                                    {% else %}
                                                        N/A
                                                    {% endif %}
                                                </td>
                                                <td style="text-align: center;">
                                                    {% if eco.date_end %}
                                                        {{ eco.date_end|date('Y-m-d H:i:s') }}
                                                    {% else %}
                                                        N/A
                                                    {% endif %}
                                                </td>
                                                <td style="text-align: center;">{{ eco.staff_id ?? 'N/A' }}</td>
                                            </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="6" style="text-align: center; color: #6b6f78; padding: 20px;">No active eco sessions</td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="admin-iot-grid">
                        <div class="admin-iot-column">
                            <div class="admin-iot-sensors-section">
                                <h2 class="admin-users-title">IoT Sensors</h2>
                                <div class="admin-iot-sensors-list">
                                    {% if iotSensors %}
                                        {% for sensor in iotSensors %}
                                            <article class="admin-iot-card"
                                                     data-id="{{ sensor.id }}"
                                                     data-name="{{ sensor.name }}"
                                                     data-start-value="{{ sensor.start_value }}"
                                                     data-end-value="{{ sensor.end_value }}"
                                                     data-description="{{ sensor.description ?? '' }}">
                                                <div class="admin-iot-info">
                                                    <h3>{{ sensor.name }}</h3>
                                                    <p class="admin-iot-meta">
                                                        Range: ({{ sensor.start_value }}) - ({{ sensor.end_value }})
                                                    </p>
                                                    <p class="admin-iot-meta" style="margin-top: 6px; color: #6b6f78;">
                                                        <strong>Used in recipes:</strong> {{ sensor.recipe_count|default(0) }}
                                                    </p>
                                                    {% if sensor.description %}
                                                        <p class="admin-iot-description">{{ sensor.description }}</p>
                                                    {% endif %}
                                                </div>
                                                <div class="admin-product-actions">
                                                    <button class="admin-btn admin-btn-edit">Edit</button>
                                                    <button class="admin-btn admin-btn-delete" 
                                                            data-sensor-id="{{ sensor.id }}"
                                                            data-sensor-name="{{ sensor.name }}">Delete</button>
                                                </div>
                                            </article>
                                        {% endfor %}
                                    {% else %}
                                        <p style="text-align: center; color: #6b6f78; padding: 40px;">No IoT sensors found. Create your first sensor!</p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <aside class="admin-product-form admin-iot-form">
                        <h2>IoT Sensor Form</h2>
                        <p class="admin-form-hint">Create or edit an IoT sensor. Fields marked with * are required.</p>

                        {% if error %}
                            <div style="background-color: #fff2f2; border: 1px solid #dc3545; border-radius: 8px; padding: 12px; margin-bottom: 16px; color: #dc3545; font-size: 13px;">
                                {{ error }}
                            </div>
                        {% endif %}

                        <form method="POST" action="index.php?action=adminIot">
                            <input type="hidden" name="id" id="iot-id">

                            <label class="admin-label">
                                <span>Name *</span>
                                <input type="text" name="name" id="iot-name" placeholder="Temperature Sensor" required maxlength="100">
                                <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Max 100 characters</small>
                            </label>

                            <div class="admin-label-row">
                                <label class="admin-label admin-label-inline">
                                    <span>Start Value *</span>
                                    <input type="number" name="start_value" id="iot-start-value" step="0.1" placeholder="-10" required>
                                </label>

                                <label class="admin-label admin-label-inline">
                                    <span>End Value *</span>
                                    <input type="number" name="end_value" id="iot-end-value" step="0.1" placeholder="30" required>
                                </label>
                            </div>

                            <label class="admin-label">
                                <span>Description</span>
                                <textarea name="description" id="iot-description" rows="3" placeholder="Sensor description..."></textarea>
                                <small style="display: block; margin-top: 4px; color: #6b6f78; font-size: 11px;">Optional text description</small>
                            </label>

                            <div class="admin-form-actions">
                                <button type="submit" class="admin-btn admin-btn-save" id="iot-submit-btn">Create</button>
                                <button type="button" class="admin-btn admin-btn-secondary" id="iot-clear-btn">Clear</button>
                            </div>
                        </form>
                    </aside>
                    </div>
                </section>
            </main>
        </div>
    </div>
</section>
{% endblock %}
