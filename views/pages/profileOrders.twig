{% extends '/templates/base_concept.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleProfile.css">
    <link rel="stylesheet" href="/views/stylesheet/styleProfileAside.css">
    <link rel="stylesheet" href="/views/stylesheet/styleProfileOrders.css">
{% endblock %}

{% block content %}
<section class="profile-page orders-page">
    <div class="profile-layout">
        {% include 'partials/asideProfie/aside.twig' with { faShoppingBag: true } %}

        <main class="profile-content orders-content">
            <div class="profile-heading">
                <h1>Orders analytics</h1>
                <p>Keep an eye on balance, velocity of new orders, and the health of latest transactions.</p>
                <div class="profile-heading-divider"></div>
            </div>

            <section class="orders-overview">
                <article class="orders-card spend-card">
                    <div class="card-head">
                        <span>Monthly spend</span>
                        <strong>$5,420</strong>
                    </div>
                    <div class="mini-chart">
                        <svg viewBox="0 0 140 60" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="miniGradient" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="rgba(31,154,99,0.35)" />
                                    <stop offset="100%" stop-color="rgba(31,154,99,0)" />
                                </linearGradient>
                            </defs>
                            <path class="mini-area" d="M0,50 L10,42 L25,46 L40,35 L56,28 L70,24 L85,32 L100,30 L120,18 L140,24 L140,60 L0,60 Z"></path>
                            <path class="mini-line" d="M0,50 L10,42 L25,46 L40,35 L56,28 L70,24 L85,32 L100,30 L120,18 L140,24"></path>
                        </svg>
                    </div>
                    <div class="card-footer">
                        <span>Avg order value: <strong>$86</strong></span>
                        <span>Peak weekday: <strong>Thursday</strong></span>
                    </div>
                </article>

                <article class="orders-card metric-card">
                    <header>
                        <i class="fas fa-dollar-sign"></i>
                        <span>Total transactions amount</span>
                    </header>
                    <strong>$48,230</strong>
                    <small>Aggregated from `transactions.value` Q3</small>
                </article>

                <article class="orders-card metric-card">
                    <header>
                        <i class="fas fa-receipt"></i>
                        <span>Total orders count</span>
                    </header>
                    <strong>128</strong>
                    <small>`orders` table entries for the last 90 days</small>
                </article>

                <article class="orders-card metric-card">
                    <header>
                        <i class="fas fa-file-invoice"></i>
                        <span>Settled invoices</span>
                    </header>
                    <strong>96</strong>
                    <small>Transactions with `status = Completed`</small>
                </article>
            </section>

            <section class="orders-chart-section">
                <article class="orders-chart">
                    <header>
                        <h2>Spending trend</h2>
                        <span>Monthly value aggregated from `transactions.date` & `transactions.value`</span>
                    </header>
                    <div id="ordersChart"></div>
                </article>

                <div class="orders-chart-side">
                    <article class="orders-card metric-card conversion-card">
                        <header>
                            <i class="fas fa-percentage"></i>
                            <span>Conversion rate</span>
                        </header>
                        <strong>82%</strong>
                        <small>Completed vs total transactions this month</small>
                    </article>

                    <article class="orders-card metric-card pending-card">
                        <header>
                            <i class="fas fa-hourglass-half"></i>
                            <span>Pending volume</span>
                        </header>
                        <strong>$3,780</strong>
                        <small>Sum of `transactions.value` with status Pending</small>
                    </article>
                </div>
            </section>

            <section class="orders-table-profile">
                <div class="orders-table-header">
                    <h2>Recent transactions</h2>
                    <button type="button" class="orders-table-button">View all transactions</button>
                </div>
                <table class="orders-table profile-style">
                    <thead>
                    <tr>
                        <th>Hash</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Description</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for tx in transactions|slice(0,5)|default([]) %}
                        <tr class="orders-row">
                            <td><span class="order-id">{{ tx.hash }}</span></td>
                            <td>{{ tx.date }}</td>
                            <td>{{ tx.items }}</td>
                            <td><span class="order-amount">${{ tx.total }}</span></td>
                            <td><span class="status {{ tx.statusClass }}">{{ tx.status }}</span></td>
                            <td>{{ tx.description }}</td>
                        </tr>
                    {% else %}
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">84A4</span></td>
                            <td>18 Nov 2024</td>
                            <td>3 items</td>
                            <td><span class="order-amount">$1,240</span></td>
                            <td><span class="status success">Completed</span></td>
                            <td>GlowLab Refill, Velvet Skin Mask</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">61F0</span></td>
                            <td>04 Nov 2024</td>
                            <td>2 items</td>
                            <td><span class="order-amount">$870</span></td>
                            <td><span class="status success">Completed</span></td>
                            <td>PureCraft Wholesale order</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">61F5</span></td>
                            <td>20 Oct 2024</td>
                            <td>4 items</td>
                            <td><span class="order-amount">$650</span></td>
                            <td><span class="status alert">Pending</span></td>
                            <td>Retail replenishment</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">42F3</span></td>
                            <td>02 Oct 2024</td>
                            <td>1 item</td>
                            <td><span class="order-amount">$420</span></td>
                            <td><span class="status failed">Failed</span></td>
                            <td>Sample kit transfer</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">17A1</span></td>
                            <td>15 Sep 2024</td>
                            <td>3 items</td>
                            <td><span class="order-amount">$380</span></td>
                            <td><span class="status success">Completed</span></td>
                            <td>Care routine upgrade</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </main>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    (() => {
        const chartElement = document.querySelector('#ordersChart');
        if (!chartElement || typeof ApexCharts === 'undefined') return;

        const chartData = [
            { label: 'Jan', value: 4280 },
            { label: 'Feb', value: 3960 },
            { label: 'Mar', value: 5120 },
            { label: 'Apr', value: 6840 },
            { label: 'May', value: 7250 },
            { label: 'Jun', value: 8120 },
            { label: 'Jul', value: 7620 },
            { label: 'Aug', value: 6980 },
            { label: 'Sep', value: 6550 },
            { label: 'Oct', value: 7120 },
            { label: 'Nov', value: 7680 }
        ];

        const options = {
            chart: {
                type: 'area',
                height: 320,
                toolbar: { show: false },
                zoom: { enabled: false }
            },
            series: [{
                name: 'Monthly spend',
                data: chartData.map(({ value }) => value)
            }],
            stroke: {
                curve: 'smooth',
                width: 3
            },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.05,
                    stops: [0, 90, 100]
                }
            },
            colors: ['#1f9a63'],
            dataLabels: { enabled: false },
            grid: {
                borderColor: '#eef1f6',
                strokeDashArray: 4,
                padding: { left: 10, right: 10 }
            },
            xaxis: {
                categories: chartData.map(({ label }) => label),
                axisBorder: { show: false },
                axisTicks: { show: false },
                labels: {
                    style: { colors: '#8b8e96', fontSize: '12px' }
                }
            },
            yaxis: {
                labels: {
                    style: { colors: '#8b8e96', fontSize: '12px' },
                    formatter: (value) => `$${Math.round(value).toLocaleString('en-US')}`
                }
            },
            tooltip: {
                y: {
                    formatter: (value) => `$${value.toLocaleString('en-US')}`
                }
            },
            markers: {
                size: 0
            }
        };

        const chart = new ApexCharts(chartElement, options);
        chart.render();
    })();
</script>
{% endblock %}