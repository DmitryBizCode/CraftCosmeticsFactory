{% extends '/templates/base_concept.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleProfile.css">
    <link rel="stylesheet" href="/views/stylesheet/styleProfileAside.css">
    <link rel="stylesheet" href="/views/stylesheet/styleProfileOrders.css">
{% endblock %}

{% block content %}
<section class="profile-page orders-page">
    <div class="profile-layout">
        {% include 'partials/asideProfie/aside.twig' with { faShoppingBag: true } %}

        <main class="profile-content orders-content">
            <div class="profile-heading">
                <h1>Orders analytics</h1>
                <p>Keep an eye on balance, velocity of new orders, and the health of latest transactions.</p>
                <div class="profile-heading-divider"></div>
            </div>

            <section class="orders-overview">
                <article class="orders-card balance-card">
                    <div class="balance-head">
                        <span>Account balance</span>
                        <strong>$12,540.00</strong>
                    </div>
                    <div class="balance-footer">
                        <span>Primary account holder</span>
                        <strong>Valeria Beznosiuk • CLT-02345</strong>
                    </div>
                </article>

                <article class="orders-card metric-card">
                    <header>
                        <i class="fas fa-dollar-sign"></i>
                        <span>Total transactions amount</span>
                    </header>
                    <strong>$48,230</strong>
                    <small>Based on `transactions.value` aggregated this quarter.</small>
                </article>

                <article class="orders-card metric-card">
                    <header>
                        <i class="fas fa-receipt"></i>
                        <span>Total orders count</span>
                    </header>
                    <strong>128</strong>
                    <small>Records coming from `orders` table</small>
                </article>

                <article class="orders-card metric-card">
                    <header>
                        <i class="fas fa-file-invoice"></i>
                        <span>Settled invoices</span>
                    </header>
                    <strong>96</strong>
                    <small>Transactions marked as `Completed`</small>
                </article>

                <article class="orders-card metric-card">
                    <header>
                        <i class="fas fa-percentage"></i>
                        <span>Conversion rate</span>
                    </header>
                    <strong>82%</strong>
                    <small>Orders paid vs. placed • rolling 30 days</small>
                </article>

                <article class="orders-card metric-card loan-card">
                    <header>
                        <div>
                            <span>Loan balance</span>
                            <strong>$3,480</strong>
                        </div>
                        <small class="loan-delta">+$180 yesterday</small>
                    </header>
                    <ul>
                        <li><span>Total debit</span><span class="bar bar-debit"></span></li>
                        <li><span>Total credit</span><span class="bar bar-credit"></span></li>
                        <li><span>Interest</span><span class="bar bar-interest"></span></li>
                    </ul>
                </article>
            </section>

            <section class="orders-chart-section">
                <article class="orders-chart" data-chart>
                    <header>
                        <h2>Spending trend</h2>
                        <span>Monthly value aggregated from `transactions.date` & `transactions.value`</span>
                    </header>
                    <div class="chart-surface" data-chart-surface></div>
                    <footer>
                        <ul data-chart-labels></ul>
                    </footer>
                </article>
            </section>

            <section class="orders-table-profile">
                <div class="orders-table-header">
                    <h2>Recent transactions</h2>
                    <button type="button" class="orders-table-button">View all transactions</button>
                </div>
                <table class="orders-table profile-style">
                    <thead>
                    <tr>
                        <th>Hash</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Description</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for tx in transactions|slice(0,5)|default([]) %}
                        <tr class="orders-row">
                            <td><span class="order-id">{{ tx.hash }}</span></td>
                            <td>{{ tx.date }}</td>
                            <td>{{ tx.items }}</td>
                            <td><span class="order-amount">${{ tx.total }}</span></td>
                            <td><span class="status {{ tx.statusClass }}">{{ tx.status }}</span></td>
                            <td>{{ tx.description }}</td>
                        </tr>
                    {% else %}
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">84A4</span></td>
                            <td>18 Nov 2024</td>
                            <td>3 items</td>
                            <td><span class="order-amount">$1,240</span></td>
                            <td><span class="status success">Completed</span></td>
                            <td>GlowLab Refill, Velvet Skin Mask</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">61F0</span></td>
                            <td>04 Nov 2024</td>
                            <td>2 items</td>
                            <td><span class="order-amount">$870</span></td>
                            <td><span class="status success">Completed</span></td>
                            <td>PureCraft Wholesale order</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">61F5</span></td>
                            <td>20 Oct 2024</td>
                            <td>4 items</td>
                            <td><span class="order-amount">$650</span></td>
                            <td><span class="status alert">Pending</span></td>
                            <td>Retail replenishment</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">42F3</span></td>
                            <td>02 Oct 2024</td>
                            <td>1 item</td>
                            <td><span class="order-amount">$420</span></td>
                            <td><span class="status failed">Failed</span></td>
                            <td>Sample kit transfer</td>
                        </tr>
                        <tr class="orders-row placeholder-row">
                            <td><span class="order-id">17A1</span></td>
                            <td>15 Sep 2024</td>
                            <td>3 items</td>
                            <td><span class="order-amount">$380</span></td>
                            <td><span class="status success">Completed</span></td>
                            <td>Care routine upgrade</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </main>
    </div>
</section>

<script>
    (() => {
        const chartSurface = document.querySelector('[data-chart-surface]');
        if (!chartSurface) return;

        const chartData = [
            { label: 'Jan', value: 4280 },
            { label: 'Feb', value: 3960 },
            { label: 'Mar', value: 5120 },
            { label: 'Apr', value: 6840 },
            { label: 'May', value: 7250 },
            { label: 'Jun', value: 8120 },
            { label: 'Jul', value: 7620 },
            { label: 'Aug', value: 6980 },
            { label: 'Sep', value: 6550 },
            { label: 'Oct', value: 7120 },
            { label: 'Nov', value: 7680 }
        ];

        const labelsList = document.querySelector('[data-chart-labels]');
        if (labelsList) {
            labelsList.innerHTML = chartData.map(({ label }) => `<li>${label}</li>`).join('');
        }

        const values = chartData.map(({ value }) => value);
        const maxValue = Math.max(...values) * 1.08;

        const points = values.map((value, index) => {
            const x = (index / (values.length - 1)) * 100;
            const y = 90 - (value / maxValue) * 70;
            return { x, y, value };
        });

        const linePath = ['M0,100', `Q5,${points[0].y}`, `L${points[0].x},${points[0].y}`]
            .concat(points.slice(1).map(({ x, y }, i) => {
                const prev = points[i];
                const midX = (prev.x + x) / 2;
                const midY = (prev.y + y) / 2;
                return `Q${prev.x},${prev.y} ${midX},${midY} T${x},${y}`;
            })).join(' ');

        const areaPath = `${linePath} L100,100 L0,100 Z`;

        chartSurface.innerHTML = `
            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="ordersChartGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="rgba(31, 154, 99, 0.25)" />
                        <stop offset="100%" stop-color="rgba(31, 154, 99, 0)" />
                    </linearGradient>
                </defs>
                <path class="chart-area" d="${areaPath}"></path>
                <path class="chart-line" d="${linePath}"></path>
            </svg>
        `;
    })();
</script>
{% endblock %}