{% extends '/templates/base_concept.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleProfileAside.css">
    <link rel="stylesheet" href="/views/stylesheet/styleProfile.css">
{% endblock %}

{% block content %}
<section class="profile-page">
    <div class="profile-layout">
        {% include 'partials/asideProfie/aside.twig' with {faHome: true} %}

        <main class="profile-content">
            <div class="profile-heading">
                <h1>Profile</h1>
                <p>Track your preferences, loyalty tiers and latest cosmetic orders.</p>
                <div class="profile-heading-divider"></div>
            </div>

            <div class="profile-summary">
                <section class="profile-card profile-overview">
                    <div class="profile-user">
                        <div class="profile-user-head">
                            <h2 class="profile-name">{{ fullName|default('User') }}</h2>
                            <span class="profile-status">Premium User</span>
                        </div>
                        <div class="profile-avatar-wrapper">
                            <div class="profile-avatar-ring">
                                <img src="{{ userPhoto|default('/image/pfp.png') }}" alt="{{ fullName|default('User') }}" class="profile-avatar-large">
                            </div>
                        </div>
                    </div>
                </section>

                <section class="profile-card profile-details">
                    <div class="profile-details-heading">
                        <h3>Bio &amp; Beauty preferences</h3>
                        <span class="profile-online-indicator" title="Online"></span>
                    </div>
                    <div class="profile-details-grid">
                        <div class="profile-field">
                            <span class="field-label">Email</span>
                            <span class="field-value">{{ user.email|default('Not provided') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Phone Number</span>
                            <span class="field-value">{{ user.phone_number|default('Not provided') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Address</span>
                            <span class="field-value">{{ user.address|default('Not provided') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Favorite Routine</span>
                            <span class="field-value">{{ favoriteRoutine|default('None') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Skin Type</span>
                            <span class="field-value skin-type-value">{{ skinType|default('Normal to combination') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Preferred Ingredients</span>
                            <span class="field-value">{{ preferredIngredients|default('None') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Allergies</span>
                            <span class="field-value allergies-value {% if allergiesStatus == 'No known allergies' %}allergies-ok{% else %}allergies-warning{% endif %}">{{ allergiesStatus|default('Possibly has allergies') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Top Brands</span>
                            <span class="field-value">
                                {% if topBrand != 'None' and topBrandCount > 0 %}
                                    {{ topBrand }} ({{ topBrandCount }}x)
                                {% else %}
                                    None
                                {% endif %}
                            </span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Average Basket</span>
                            <span class="field-value">${{ averageBasket|number_format(2, '.', ',')|default('0.00') }}</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Last Purchase</span>
                            {% if lastOrder %}
                                <span class="field-value">{{ lastOrder.date }} • {{ lastOrder.description }}</span>
                            {% else %}
                                <span class="field-value" style="color: #6b6f78; font-style: italic;">No purchases yet</span>
                            {% endif %}
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Subscription</span>
                            <span class="field-chip success">Auto-refill active</span>
                        </div>
                        <div class="profile-field">
                            <span class="field-label">Loyalty points</span>
                            <span class="field-chip info">{{ loyaltyPoints|default(0) }} pts</span>
                        </div>
                    </div>
                </section>
            </div>

            <section class="profile-grid-two">
                <section class="profile-card profile-social">
                    <div class="profile-social-header">
                        <div class="profile-social-title">
                            <span class="profile-social-icon"><i class="fas fa-share-alt"></i></span>
                            <div>
                                <h3>Social channels</h3>
                                <p class="profile-social-note">Share your routines with the community</p>
                            </div>
                        </div>
                    </div>
                    <div class="profile-social-links big">
                        {% if socialChannels|length > 0 %}
                            {% for channel in socialChannels %}
                                {% set platformIcon = 'fa-link' %}
                                {% if channel.platform|lower == 'youtube' %}
                                    {% set platformIcon = 'fab fa-youtube' %}
                                {% elseif channel.platform|lower == 'instagram' %}
                                    {% set platformIcon = 'fab fa-instagram' %}
                                {% elseif channel.platform|lower == 'tiktok' %}
                                    {% set platformIcon = 'fab fa-tiktok' %}
                                {% elseif channel.platform|lower == 'facebook' %}
                                    {% set platformIcon = 'fab fa-facebook' %}
                                {% elseif channel.platform|lower == 'twitter' %}
                                    {% set platformIcon = 'fab fa-twitter' %}
                                {% endif %}
                                <a href="{{ channel.url|default('#') }}" target="_blank">
                                    <i class="{{ platformIcon }}"></i> {{ channel.handle }}
                                </a>
                            {% endfor %}
                        {% else %}
                            <p style="color: #6b6f78; font-style: italic; padding: 20px; text-align: center;">No social channels added yet</p>
                        {% endif %}
                    </div>
                </section>

                <section class="profile-card profile-reminders">
                    <h3>Care reminders</h3>
                    <ul class="profile-reminder-list">
                        {% if careReminders|length > 0 %}
                            {% for reminder in careReminders %}
                                <li>
                                    <span>{{ reminder.text }}</span>
                                    <span class="reminder-chip{% if reminder.chip_type %} {{ reminder.chip_type }}{% endif %}">{{ reminder.chip }}</span>
                                </li>
                            {% endfor %}
                        {% else %}
                            <li style="color: #6b6f78; font-style: italic; padding: 10px;">No reminders available</li>
                        {% endif %}
                    </ul>
                </section>
            </section>

            <section class="profile-card profile-orders">
                <div class="profile-productions-header">
                    <h3>Last orders</h3>
                    <a href="index.php?action=ordersProfile" class="profile-button accent">View all orders</a>
                </div>
                <table class="profile-table">
                    <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Description</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if orders|length > 0 %}
                        {% for order in orders %}
                            <tr>
                                <td><span class="order-id">{{ order.order_id }}</span></td>
                                <td>{{ order.date }}</td>
                                <td>{{ order.quantity }} item{{ order.quantity != 1 ? 's' : '' }}</td>
                                <td><span class="order-amount">${{ order.total|number_format(2, '.', ',') }}</span></td>
                                <td style="text-align: center;">
                                    <span class="order-status {% if order.status|lower == 'completed' %}success{% elseif order.status|lower == 'pending' %}pending{% else %}success{% endif %}">
                                        {{ order.status }}
                                    </span>
                                </td>
                                <td>{{ order.description|slice(0, 50) }}{% if order.description|length > 50 %}...{% endif %}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align: center; color: #6b6f78; font-style: italic; padding: 40px;">
                                No orders yet. Start shopping to see your orders here!
                            </td>
                        </tr>
                    {% endif %}
                    </tbody>
                </table>
            </section>
        </main>
    </div>
</section>
{% endblock %}
