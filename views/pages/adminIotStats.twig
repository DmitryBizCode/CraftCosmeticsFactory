{% extends '/templates/base_admin.twig' %}

{% block linksScript %}
    <link rel="stylesheet" href="/views/stylesheet/styleAdmin.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sensorsStats = {{ sensorsStats|json_encode|raw }};
            
            // Обробка зміни періоду
            const timeRangeSelect = document.getElementById('time-range-select');
            if (timeRangeSelect) {
                timeRangeSelect.addEventListener('change', function() {
                    const value = this.value;
                    window.location.href = 'index.php?action=adminIotStats&recipe_id={{ recipeId }}&period=' + encodeURIComponent(value);
                });
            }

            // Створюємо гістограми для кожного датчика
            sensorsStats.forEach(function(sensorStat) {
                const canvasId = 'stats-chart-' + sensorStat.id;
                const ctx = document.getElementById(canvasId);
                if (!ctx) return;

                // Підготовка даних для гістограми
                const labels = [];
                const values = [];
                
                sensorStat.histogram.forEach(function(day) {
                    labels.push(day.date);
                    values.push(parseFloat(day.avg_value));
                });

                // Якщо немає даних, показуємо порожній графік
                if (values.length === 0) {
                    labels.push('No data');
                    values.push(0);
                }

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: sensorStat.name,
                            data: values,
                            backgroundColor: '#111111',
                            borderColor: '#111111',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: {
                            padding: {
                                top: 10,
                                bottom: 10
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });

                // Оновлюємо метрики
                const avgEl = document.getElementById('avg-' + sensorStat.id);
                const minEl = document.getElementById('min-' + sensorStat.id);
                const maxEl = document.getElementById('max-' + sensorStat.id);
                
                if (avgEl) avgEl.textContent = sensorStat.avg.toFixed(1);
                if (minEl) minEl.textContent = sensorStat.min.toFixed(1);
                if (maxEl) maxEl.textContent = sensorStat.max.toFixed(1);
            });
        });
    </script>
{% endblock %}

{% block content %}
<section class="admin-page admin-page-dashboard">
    <div class="admin-dashboard">
        <div class="admin-layout">
            {% include 'partials/adminSidebar.twig' %}

            <main class="admin-main">
                <header class="admin-main-header">
                    <div>
                        <h1>IoT Sensors Statistics</h1>
                        <p>Recipe: <strong>{{ recipe.name }}</strong> (ID: {{ recipeId }})</p>
                    </div>
                    <div class="admin-header-actions">
                        <a href="index.php?action=adminEcoSystem&recipe_id={{ recipeId }}" class="admin-header-link">
                            Eco-System Control
                        </a>
                        <a href="index.php?action=adminRecipes" class="admin-header-link">
                            Back to Recipes
                        </a>
                    </div>
                </header>

                <section class="admin-iot-stats">
                    <div class="admin-stats-time-range">
                        <label class="admin-stats-time-range-label">
                            <span class="admin-stats-time-range-label-text">Time Range:</span>
                            <select id="time-range-select" class="admin-stats-time-range-select">
                                <option value="hour" {{ period == 'hour' ? 'selected' : '' }}>Last hour</option>
                                <option value="day" {{ period == 'day' ? 'selected' : '' }}>Last day</option>
                                <option value="7" {{ period == '7' ? 'selected' : '' }}>Last 7 days</option>
                                <option value="14" {{ period == '14' ? 'selected' : '' }}>Last 14 days</option>
                                <option value="30" {{ period == '30' ? 'selected' : '' }}>Last month</option>
                                <option value="90" {{ period == '90' ? 'selected' : '' }}>Last 3 months</option>
                            </select>
                        </label>
                    </div>

                    <div class="admin-stats-grid">
                        {% if sensorsStats|length > 0 %}
                            {% for sensorStat in sensorsStats %}
                                <div class="admin-stats-card-large">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                                        <div>
                                            <h3>{{ sensorStat.name }} Sensor</h3>
                                            <div style="margin-top: 8px; font-size: 13px; color: #6b6f78;">
                                                Range: 
                                                {% if sensorStat.start_value < 0 and sensorStat.end_value < 0 %}
                                                    ({{ sensorStat.start_value|number_format(1) }}) to ({{ sensorStat.end_value|number_format(1) }})
                                                {% elseif sensorStat.start_value < 0 %}
                                                    ({{ sensorStat.start_value|number_format(1) }}) to {{ sensorStat.end_value|number_format(1) }}
                                                {% elseif sensorStat.end_value < 0 %}
                                                    {{ sensorStat.start_value|number_format(1) }} to ({{ sensorStat.end_value|number_format(1) }})
                                                {% else %}
                                                    {{ sensorStat.start_value|number_format(1) }} to {{ sensorStat.end_value|number_format(1) }}
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="admin-stats-critical-warnings">
                                            <div class="admin-stats-critical-warnings-label">Critical Warnings</div>
                                            <div class="admin-stats-critical-warnings-value">{{ sensorStat.critical_warnings_count }}</div>
                                        </div>
                                    </div>
                                    <div class="admin-stats-chart-container admin-stats-chart-container-tall">
                                        <canvas id="stats-chart-{{ sensorStat.id }}"></canvas>
                                    </div>
                                    <div class="admin-stats-metrics">
                                        <div class="admin-metric">
                                            <span class="admin-metric-label">Average:</span>
                                            <span class="admin-metric-value" id="avg-{{ sensorStat.id }}">{{ sensorStat.avg|number_format(1) }}</span>
                                        </div>
                                        <div class="admin-metric">
                                            <span class="admin-metric-label">Min:</span>
                                            <span class="admin-metric-value" id="min-{{ sensorStat.id }}">{{ sensorStat.min|number_format(1) }}</span>
                                        </div>
                                        <div class="admin-metric">
                                            <span class="admin-metric-label">Max:</span>
                                            <span class="admin-metric-value" id="max-{{ sensorStat.id }}">{{ sensorStat.max|number_format(1) }}</span>
                                        </div>
                                    </div>
                                    <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #e9ecef; font-size: 12px; color: #6b6f78;">
                                        Total readings: {{ sensorStat.count }}
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="admin-stats-card-large" style="text-align: center; padding: 40px;">
                                <p style="color: #6b6f78;">No sensors found for this recipe.</p>
                            </div>
                        {% endif %}
                    </div>
                </section>
            </main>
        </div>
    </div>
</section>
{% endblock %}
